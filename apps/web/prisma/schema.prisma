generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model alert_reviews {
  id              String          @id
  alert_id        String
  reviewer_id     String
  action          String
  notes           String?
  created_at      DateTime        @default(now())
  alerts          alerts          @relation(fields: [alert_id], references: [id], onDelete: Cascade)
  mentor_profiles mentor_profiles @relation(fields: [reviewer_id], references: [id])

  @@index([alert_id])
  @@index([reviewer_id])
}

model alert_rules {
  id                 String             @id
  organization_id    String
  metric_id          String
  name               String
  operator           String
  threshold          Float
  severity           String
  cooldown_hours     Int                @default(24)
  active             Boolean            @default(true)
  created_at         DateTime           @default(now())
  updated_at         DateTime
  metric_definitions metric_definitions @relation(fields: [metric_id], references: [id], onDelete: Cascade)
  organizations      organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  alerts             alerts[]

  @@index([metric_id])
  @@index([organization_id, active])
}

model alerts {
  id            String          @id
  rule_id       String
  enrollment_id String
  severity      String
  trigger_value Float
  message       String?
  resolved_at   DateTime?
  created_at    DateTime        @default(now())
  alert_reviews alert_reviews[]
  enrollments   enrollments     @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  alert_rules   alert_rules     @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([enrollment_id, resolved_at])
  @@index([rule_id, created_at])
}

model assessment_sessions {
  id              String                  @id
  organization_id String
  socio_id        String
  lesson_key      String
  block_id        String?
  kind            String                  @default("teach_back")
  status          AssessmentSessionStatus @default(pending)
  attempt_number  Int                     @default(1)
  turn_count      Int                     @default(0)
  live_state      Json?
  scores          Json?
  passed_at       DateTime?
  completed_at    DateTime?
  config_snapshot Json?
  created_at      DateTime                @default(now())
  updated_at      DateTime
  channel         String                  @default("web")
  socios          socios                  @relation(fields: [socio_id], references: [id])
  messages        messages[]

  @@unique([socio_id, lesson_key, attempt_number])
  @@index([organization_id])
  @@index([socio_id, status])
}

model audit_log {
  id          String   @id
  actor_id    String
  action      String
  target_type String
  target_id   String?
  metadata    Json?
  created_at  DateTime @default(now())

  @@index([actor_id, created_at])
  @@index([target_type, target_id])
}

model cohorts {
  id                     String                   @id
  program_id             String
  program_version_id     String?
  slug                   String
  name                   String
  starts_at              DateTime?
  ends_at                DateTime?
  created_at             DateTime                 @default(now())
  programs               programs                 @relation(fields: [program_id], references: [id], onDelete: Cascade)
  program_versions       program_versions?        @relation(fields: [program_version_id], references: [id])
  enrollment_invitations enrollment_invitations[]
  enrollments            enrollments[]

  @@unique([program_id, slug])
  @@index([program_id])
}

model content_collections {
  id               String             @id
  organization_id  String
  slug             String
  name             String
  description      String?
  created_at       DateTime           @default(now())
  updated_at       DateTime
  organizations    organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  content_lessons  content_lessons[]
  program_versions program_versions[]

  @@unique([organization_id, slug])
  @@index([organization_id])
}

model content_lessons {
  id                  String              @id
  collection_id       String
  slug                String
  order_index         Int
  created_at          DateTime            @default(now())
  updated_at          DateTime
  content_collections content_collections @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  lesson_versions     lesson_versions[]

  @@unique([collection_id, slug])
  @@index([collection_id, order_index])
}

model enrollment_invitations {
  id         String    @id
  cohort_id  String
  channel    String
  target     String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  cohorts    cohorts   @relation(fields: [cohort_id], references: [id], onDelete: Cascade)

  @@index([cohort_id])
  @@index([token])
}

model enrollments {
  id                   String                @id
  participant_id       String
  cohort_id            String
  program_version_id   String?
  status               String                @default("active")
  enrolled_at          DateTime              @default(now())
  completed_at         DateTime?
  metadata             Json?
  alerts               alerts[]
  cohorts              cohorts               @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  participant_profiles participant_profiles  @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  program_versions     program_versions?     @relation(fields: [program_version_id], references: [id])
  metric_observations  metric_observations[]

  @@unique([participant_id, cohort_id])
  @@index([cohort_id])
  @@index([participant_id])
}

model feedback {
  id         String   @id
  page       String
  subject    String
  body       String
  created_at DateTime @default(now())
}

model financial_snapshots {
  id              String   @id
  socio_id        String
  week_start_date DateTime
  revenue         Float
  net_profit      Float
  source          String   @default("ai_marker")
  created_at      DateTime @default(now())
  socios          socios   @relation(fields: [socio_id], references: [id])

  @@unique([socio_id, week_start_date], map: "financial_snapshot_socio_week_key")
  @@index([socio_id, week_start_date])
}

model lesson_progress {
  id            String    @id
  socio_id      String
  lesson_number Int
  understanding Int?
  completed_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime
  socios        socios    @relation(fields: [socio_id], references: [id])

  @@unique([socio_id, lesson_number], map: "lesson_progress_socio_lesson_key")
  @@index([socio_id, completed_at])
}

model lesson_versions {
  id              String          @id
  lesson_id       String
  version         String
  lang            String          @default("es")
  title           String
  body            Json
  active          Boolean         @default(false)
  published_at    DateTime?
  created_at      DateTime        @default(now())
  content_lessons content_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([lesson_id, version, lang])
  @@index([lesson_id, active])
}

model mentor_profiles {
  id                      String                    @id
  organization_id         String
  mentor_id               String?                   @unique
  display_name            String?
  specialties             String[]                  @default([])
  metadata                Json?
  created_at              DateTime                  @default(now())
  updated_at              DateTime
  alert_reviews           alert_reviews[]
  mentors                 mentors?                  @relation(fields: [mentor_id], references: [id])
  organizations           organizations             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  mentoring_relationships mentoring_relationships[]

  @@index([organization_id])
}

model mentoring_relationships {
  id                   String               @id
  mentor_profile_id    String
  participant_id       String
  role                 String               @default("primary")
  active_from          DateTime             @default(now())
  active_until         DateTime?
  created_at           DateTime             @default(now())
  mentor_profiles      mentor_profiles      @relation(fields: [mentor_profile_id], references: [id], onDelete: Cascade)
  participant_profiles participant_profiles @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@unique([mentor_profile_id, participant_id, role])
  @@index([mentor_profile_id])
  @@index([participant_id])
}

model mentors {
  id                 String           @id
  name               String
  email              String           @unique
  role               String
  created_at         DateTime         @default(now())
  password_hash      String?
  preferred_language String           @default("en")
  mentor_profiles    mentor_profiles?
  socios             socios[]
}

model message_sentiments {
  id          String   @id
  message_id  String   @unique
  socio_id    String
  confusion   Int
  frustration Int
  urgency     Int
  sentiment   String
  topics      String[]
  created_at  DateTime @default(now())
  messages    messages @relation(fields: [message_id], references: [id])
  socios      socios   @relation(fields: [socio_id], references: [id])

  @@index([sentiment, created_at])
  @@index([socio_id, created_at])
}

model messages {
  id                    String               @id
  socio_id              String
  role                  String
  content               String
  created_at            DateTime             @default(now())
  sender_type           String?
  assessment_session_id String?
  metadata              Json?
  message_sentiments    message_sentiments?
  assessment_sessions   assessment_sessions? @relation(fields: [assessment_session_id], references: [id], onDelete: Cascade)
  socios                socios               @relation(fields: [socio_id], references: [id])

  @@index([assessment_session_id, created_at])
  @@index([socio_id, created_at])
}

model metric_definitions {
  id                  String                @id
  organization_id     String
  key                 String
  name                String
  description         String?
  category            String
  data_type           String
  scale               Json?
  created_at          DateTime              @default(now())
  updated_at          DateTime
  alert_rules         alert_rules[]
  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  metric_observations metric_observations[]

  @@unique([organization_id, key])
  @@index([organization_id])
}

model metric_observations {
  id                  String             @id
  metric_id           String
  enrollment_id       String?
  signal_type         String
  value               Float
  confidence          Float?
  evidence_refs       Json?
  model_version       String?
  prompt_version      String?
  verification_status String?
  source              ObservationSource
  observed_at         DateTime
  created_at          DateTime           @default(now())
  enrollments         enrollments?       @relation(fields: [enrollment_id], references: [id])
  metric_definitions  metric_definitions @relation(fields: [metric_id], references: [id], onDelete: Cascade)

  @@index([enrollment_id, observed_at])
  @@index([metric_id, observed_at])
}

model organization_memberships {
  id              String        @id
  organization_id String
  user_id         String
  role            String
  created_at      DateTime      @default(now())
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id])
  @@index([organization_id])
  @@index([user_id])
}

model organizations {
  id                       String                     @id
  slug                     String                     @unique
  name                     String
  settings                 Json?
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  alert_rules              alert_rules[]
  content_collections      content_collections[]
  mentor_profiles          mentor_profiles[]
  metric_definitions       metric_definitions[]
  organization_memberships organization_memberships[]
  participant_profiles     participant_profiles[]
  programs                 programs[]
}

model participant_profiles {
  id                      String                    @id
  organization_id         String
  socio_id                String?                   @unique
  display_name            String?
  preferred_lang          String                    @default("es")
  metadata                Json?
  created_at              DateTime                  @default(now())
  updated_at              DateTime
  enrollments             enrollments[]
  mentoring_relationships mentoring_relationships[]
  organizations           organizations             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  socios                  socios?                   @relation(fields: [socio_id], references: [id])

  @@index([organization_id])
}

model password_reset_tokens {
  id         String    @id
  email      String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([email, expires_at])
}

model program_config {
  id          String   @id
  key         String   @unique
  value       String
  type        String
  label       String
  description String?
  category    String
  updated_by  String?
  updated_at  DateTime
}

model program_versions {
  id                  String               @id
  program_id          String
  version             String
  config              Json
  active              Boolean              @default(false)
  published_at        DateTime?
  created_at          DateTime             @default(now())
  collection_id       String?
  primary_lang        String               @default("es")
  published_by        String?
  status              ProgramVersionStatus @default(draft)
  cohorts             cohorts[]
  enrollments         enrollments[]
  content_collections content_collections? @relation(fields: [collection_id], references: [id])
  programs            programs             @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([program_id, version])
  @@index([program_id, active])
  @@index([program_id, status])
}

model programs {
  id               String             @id
  organization_id  String
  slug             String
  name             String
  description      String?
  created_at       DateTime           @default(now())
  updated_at       DateTime
  cohorts          cohorts[]
  program_versions program_versions[]
  organizations    organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, slug])
  @@index([organization_id])
}

model socio_contexts {
  id               String   @id
  socio_id         String   @unique
  business_type    String?
  products         String?
  monthly_revenue  String?
  monthly_expenses String?
  num_employees    String?
  location         String?
  challenges       String?
  goals            String?
  family_context   String?
  custom_facts     String?
  updated_at       DateTime
  created_at       DateTime @default(now())
  socios           socios   @relation(fields: [socio_id], references: [id])
}

model socio_dimension_states {
  id            String   @id
  socio_id      String
  dimension_key String
  level         Float
  trend         String
  confidence    Float
  evidence      String?
  updated_at    DateTime
  created_at    DateTime @default(now())
  socios        socios   @relation(fields: [socio_id], references: [id], onDelete: Cascade)

  @@unique([socio_id, dimension_key], map: "socio_dimension_state_unique")
  @@index([socio_id])
}

model socio_feedback {
  id         String   @id
  socio_id   String
  lesson_num Int
  rating     Int?
  comment    String?
  created_at DateTime @default(now())
  socios     socios   @relation(fields: [socio_id], references: [id], onDelete: Cascade)

  @@index([socio_id, lesson_num])
}

model socio_flags {
  id          String    @id
  socio_id    String
  level       String
  reason      String
  resolved    Boolean   @default(false)
  resolved_at DateTime?
  created_at  DateTime  @default(now())
  source      String    @default("ai_marker")
  resolved_by String?
  message_id  String?
  socios      socios    @relation(fields: [socio_id], references: [id])

  @@index([resolved, level, created_at])
  @@index([socio_id, resolved])
}

model socio_progress {
  id                       String    @id
  socio_id                 String    @unique
  current_lesson_number    Int       @default(1)
  current_message_index    Int       @default(0)
  completed_lessons        Int[]     @default([])
  weekly_understanding     Int?
  weekly_implementation    Int?
  last_lesson_completed_at DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime
  last_interaction_at      DateTime?
  reminders_sent           Int       @default(0)
  socios                   socios    @relation(fields: [socio_id], references: [id])
}

model socios {
  id                        String                   @id
  whatsapp_phone_number     String?                  @unique
  name                      String?
  business_name             String?
  business_description      String?
  status                    OnboardingStatus         @default(NEW)
  prompt_overrides          Json?
  metadata                  Json?
  created_at                DateTime                 @default(now())
  updated_at                DateTime
  channel_type              String                   @default("whatsapp")
  external_id               String                   @default("")
  language                  String                   @default("es")
  mentor_id                 String?
  password_hash             String?
  ai_paused                 Boolean                  @default(false)
  curriculum_collection_key String?
  assessment_sessions       assessment_sessions[]
  financial_snapshots       financial_snapshots[]
  lesson_progress           lesson_progress[]
  message_sentiments        message_sentiments[]
  messages                  messages[]
  participant_profiles      participant_profiles?
  socio_contexts            socio_contexts?
  socio_dimension_states    socio_dimension_states[]
  socio_feedback            socio_feedback[]
  socio_flags               socio_flags[]
  socio_progress            socio_progress?
  mentors                   mentors?                 @relation(fields: [mentor_id], references: [id])
  summaries                 summaries[]

  @@unique([channel_type, external_id], map: "socios_channel_external_id_key")
  @@index([mentor_id, status])
  @@index([status, updated_at])
}

model summaries {
  id              String   @id
  socio_id        String
  week_start_date DateTime
  content         String
  flags           Json?
  metrics         Json?
  created_at      DateTime @default(now())
  socios          socios   @relation(fields: [socio_id], references: [id])

  @@index([socio_id, week_start_date])
}

model system_logs {
  id         String   @id
  level      String
  category   String
  message    String
  metadata   String?
  created_at DateTime @default(now())

  @@index([category, created_at])
  @@index([level, created_at])
}

model system_prompts {
  id         String   @id
  version    String
  content    String
  category   String
  active     Boolean  @default(false)
  author_id  String
  created_at DateTime @default(now())

  @@index([category, active])
}

enum AssessmentSessionStatus {
  pending
  in_progress
  completed
}

enum ObservationSource {
  self_reported
  human_recorded
  system_observed
  calculated
  ai_inferred
}

enum OnboardingStatus {
  NEW
  AWAITING_LANGUAGE
  AWAITING_CONSENT
  AWAITING_NAME
  AWAITING_BUSINESS
  ACTIVE
}

enum ProgramVersionStatus {
  draft
  published
  archived
}
