generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemPrompt {
  id        String   @id @default(uuid())
  version   String   // e.g., "1.0", "1.1-beta"
  content   String
  // One of PROMPT_CATEGORIES in src/lib/ai/prompts/categories.ts
  category  String
  active    Boolean  @default(false)
  authorId  String   @map("author_id")
  // Scope: null means "applies more broadly". Resolution walks
  //   (org, collection) -> (org, null) -> (null, null) -> code constant
  // so an unscoped row keeps behaving exactly as it did before scoping existed.
  organizationId String? @map("organization_id")
  // ContentCollection.slug, matching Socio.curriculumCollectionKey. Replaces
  // the old `category = "core:{collectionKey}"` string-namespacing hack.
  collectionKey  String? @map("collection_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, active])
  @@index([organizationId, collectionKey, category, active])
  @@map("system_prompts")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String // "info", "warn", "error"
  category  String // "ai", "webhook", "auth", "cron", "system"
  message   String
  metadata  String? // JSON string
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, createdAt])
  @@index([level, createdAt])
  @@map("system_logs")
}

enum OnboardingStatus {
  NEW
  AWAITING_LANGUAGE
  AWAITING_CONSENT
  AWAITING_NAME
  AWAITING_BUSINESS
  ACTIVE
}

model Socio {
  id                  String           @id @default(uuid())
  whatsappPhoneNumber String?          @unique @map("whatsapp_phone_number")
  channelType         String           @default("whatsapp") @map("channel_type")
  externalId          String           @default("") @map("external_id")
  language            String           @default("en") @map("language")
  passwordHash        String?          @map("password_hash")
  name                String?
  businessName        String?          @map("business_name")
  businessDescription String?          @map("business_description")
  status              OnboardingStatus @default(NEW)
  promptOverrides     Json?            @map("prompt_overrides")
  aiPaused            Boolean          @default(false) @map("ai_paused")
  metadata            Json?
  mentorId            String?          @map("mentor_id")
  /// Still authoritative for the frozen chat surface (D1) — /chat routing,
  /// messaging/handler.ts content selection, onboarding script lookup. NOT
  /// deprecated there. DEPRECATED (A.6 candidate, A.5) specifically as a
  /// player-access GATE: resolvePlayerAccess now grants on Enrollment alone
  /// and only reads this field for a diagnostic log line on enrollment-miss,
  /// never to grant. Do not add a new player-surface read of this field.
  curriculumCollectionKey String?      @map("curriculum_collection_key")
  /// Soft-archive marker (A.3). Deliberately NOT a `status` enum value:
  /// `OnboardingStatus` is the onboarding funnel (NEW..ACTIVE), a closed set
  /// several switch statements exhaustively match on
  /// (`onboarding/service.ts`); repurposing it for account lifecycle would
  /// conflate two different concerns and risk an unhandled-case fallthrough.
  /// A separate nullable timestamp is the same pattern already used
  /// elsewhere in this schema for soft state (completedAt, resolvedAt,
  /// reachedAt). Non-null = archived; every dashboard/listing/aggregate-count
  /// read path must filter `archivedAt: null` — see A.3 report for the full
  /// list of call sites this required.
  archivedAt          DateTime?        @map("archived_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  mentor     Mentor?   @relation(fields: [mentorId], references: [id])
  messages   Message[]
  summaries  Summary[]
  progress   SocioProgress?
  flags      SocioFlag[]
  lessonProgress LessonProgress[]
  sentiments MessageSentiment[]
  financialSnapshots FinancialSnapshot[]
  context            SocioContext?
  feedback           SocioFeedback[]
  dimensionStates    SocioDimensionState[]
  participantProfile ParticipantProfile?
  assessmentSessions AssessmentSession[]
  milestoneProgress  MilestoneProgress[]
  blockProgress      BlockProgress[]
  diagnosticAttempts DiagnosticAttempt[]
  ltiIdentities      LtiIdentity[]
  gradeDeliveries    LtiGradeDelivery[]

  @@unique([channelType, externalId], map: "socios_channel_external_id_key")
  @@index([mentorId, status])
  @@index([status, updatedAt])
  @@map("socios")
}

model SocioFeedback {
  id        String   @id @default(uuid())
  socioId   String   @map("socio_id")
  lessonNum Int      @map("lesson_num")
  rating    Int?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId, lessonNum])
  @@map("socio_feedback")
}

model Mentor {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  role               String   // "mentor", "admin"
  preferredLanguage  String   @default("en") @map("preferred_language")
  createdAt          DateTime @default(now()) @map("created_at")

  socios        Socio[]
  mentorProfile MentorProfile?
  ltiIdentities LtiIdentity[]

  @@map("mentors")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("password_reset_tokens")
}

model ProgramConfig {
  id          String   @id @default(uuid())
  key         String
  value       String   // JSON-encoded
  type        String   // "number", "boolean", "string", "json"
  label       String   // Human-readable label for the UI
  description String?
  category    String   // "lesson_pacing", "ai_behavior", "flagging", "reminders", "onboarding"
  // Scope: null means "applies more broadly", same three-tier walk as
  // SystemPrompt. `key` was globally unique before this, which is precisely
  // why two courses could not hold different values for it.
  organizationId String? @map("organization_id")
  collectionKey  String? @map("collection_key")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, collectionKey, key], map: "program_config_scope_key")
  @@index([organizationId, collectionKey])
  @@map("program_config")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String   // "changed_config", "updated_prompt", "activated_prompt", "resolved_flag", "assigned_mentor"
  targetType String   @map("target_type") // "program_config", "system_prompt", "socio", "mentor"
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

model Feedback {
  id        String   @id @default(uuid())
  page      String   // which page the feedback is about (user-selected)
  pagePath  String?  @map("page_path") // actual URL path, derived from Referer
  subject   String   // short subject line
  body      String   // full feedback text
  // Attribution is opportunistic: the feedback widget is deliberately available
  // logged-out, so all three are null for an anonymous report.
  userId    String?  @map("user_id")
  role      String?  // "socio" | "mentor" | "admin" — snapshot at submit time
  // Null unless the submitter is a socio whose org resolved at tier 1 or 2.
  // A tier-3 (DEFAULT_ORGANIZATION_ID) resolution writes null rather than
  // stamping a guess — same fail-closed rule as resolveDashboardPanels.
  organizationId String? @map("organization_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("feedback")
}

model Message {
  id         String   @id @default(uuid())
  socioId    String   @map("socio_id")
  role       String   // "user", "assistant", "system"
  content    String
  senderType String?  @map("sender_type") // "ai", "mentor", null (legacy)
  createdAt  DateTime @default(now()) @map("created_at")

  assessmentSessionId String? @map("assessment_session_id")
  metadata            Json?

  socio             Socio              @relation(fields: [socioId], references: [id])
  sentiment         MessageSentiment?
  assessmentSession AssessmentSession? @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)

  @@index([assessmentSessionId, createdAt])
  @@index([socioId, createdAt])
  @@map("messages")
}

model SocioProgress {
  id                    String    @id @default(uuid())
  socioId               String    @unique @map("socio_id")
  currentLessonNumber   Int       @default(1) @map("current_lesson_number")
  currentMessageIndex   Int       @default(0) @map("current_message_index")
  completedLessons      Int[]     @default([]) @map("completed_lessons")
  weeklyUnderstanding   Int?      @map("weekly_understanding")
  weeklyImplementation  Int?      @map("weekly_implementation")
  lastLessonCompletedAt DateTime? @map("last_lesson_completed_at")
  remindersSent         Int       @default(0) @map("reminders_sent")
  lastInteractionAt     DateTime? @map("last_interaction_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("socio_progress")
}

model Summary {
  id            String   @id @default(uuid())
  socioId       String   @map("socio_id")
  weekStartDate DateTime @map("week_start_date")
  content       String
  flags         Json?
  metrics       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@index([socioId, weekStartDate])
  @@map("summaries")
}

model SocioFlag {
  id         String    @id @default(uuid())
  socioId    String    @map("socio_id")
  level      String    // "RED" | "YELLOW"
  reason     String
  source     String    @default("ai_marker") // "ai_marker", "sentiment_auto", "mentor_manual"
  resolved   Boolean   @default(false)
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  messageId  String?   @map("message_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Lifecycle fields. `resolved` above stays the source of truth for now;
  // `status` is written alongside it but not yet read.
  reasonCode      String?   @map("reason_code")
  reasonParams    Json?     @map("reason_params")
  status          String    @default("OPEN") // FlagStatus
  disposition     String?   // FlagDisposition
  snoozedUntil    DateTime? @map("snoozed_until")
  occurrenceCount Int       @default(1) @map("occurrence_count")
  lastOccurredAt  DateTime? @map("last_occurred_at")

  socio  Socio       @relation(fields: [socioId], references: [id])
  events FlagEvent[]

  @@index([socioId, resolved])
  @@index([resolved, level, createdAt])
  @@index([status, level, createdAt])
  @@map("socio_flags")
}

/// Append-only audit trail of everything that happens to a SocioFlag.
model FlagEvent {
  id              String   @id @default(uuid())
  flagId          String   @map("flag_id")
  actorId         String?  @map("actor_id")
  actorType       String   @map("actor_type") // "mentor" | "ai" | "system"
  eventType       String   @map("event_type")
  disposition     String?
  note            String?
  linkedMessageId String?  @map("linked_message_id")
  createdAt       DateTime @default(now()) @map("created_at")

  flag SocioFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, createdAt])
  @@map("flag_events")
}

model LessonProgress {
  id                  String    @id @default(uuid())
  socioId             String    @map("socio_id")
  lessonNumber        Int       @map("lesson_number")
  understanding       Int?
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@unique([socioId, lessonNumber], map: "lesson_progress_socio_lesson_key")
  @@index([socioId, completedAt])
  @@map("lesson_progress")
}

model MessageSentiment {
  id          String   @id @default(uuid())
  messageId   String   @unique @map("message_id")
  socioId     String   @map("socio_id")
  confusion   Int      // 0-10
  frustration Int      // 0-10
  urgency     Int      // 0-10
  sentiment   String   // "positive", "neutral", "negative", "distressed"
  topics      String[] // e.g. ["finances", "business", "personal"]
  createdAt   DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id])
  socio   Socio   @relation(fields: [socioId], references: [id])

  @@index([socioId, createdAt])
  @@index([sentiment, createdAt])
  @@map("message_sentiments")
}

model SocioContext {
  id               String   @id @default(uuid())
  socioId          String   @unique @map("socio_id")
  businessType     String?  @map("business_type")
  products         String?  @map("products")
  monthlyRevenue   String?  @map("monthly_revenue")
  monthlyExpenses  String?  @map("monthly_expenses")
  numEmployees     String?  @map("num_employees")
  location         String?  @map("location")
  challenges       String?  @map("challenges")
  goals            String?  @map("goals")
  familyContext    String?  @map("family_context")
  customFacts      String?  @map("custom_facts")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("socio_contexts")
}

model FinancialSnapshot {
  id            String   @id @default(uuid())
  socioId       String   @map("socio_id")
  weekStartDate DateTime @map("week_start_date")
  revenue       Float
  netProfit     Float    @map("net_profit")
  source        String   @default("ai_marker") // "ai_marker", "manual", "cron"
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@unique([socioId, weekStartDate], map: "financial_snapshot_socio_week_key")
  @@index([socioId, weekStartDate])
  @@map("financial_snapshots")
}

model SocioDimensionState {
  id            String   @id @default(cuid())
  socioId       String   @map("socio_id")
  dimensionKey  String   @map("dimension_key") // "comprehension" | "confusion" (matches DIMENSION_DEFINITIONS)
  level         Float    // 0-10, continuous
  trend         String   // "improving" | "flat" | "declining"
  confidence    Float    // 0-1, sensing model's certainty
  evidence      String?  // short excerpt/summary backing this update
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@unique([socioId, dimensionKey], map: "socio_dimension_state_unique")
  @@index([socioId])
  @@map("socio_dimension_states")
}

// ════════════════════════════════════════════════════════════════════════════
// Phase 1: Generalized Domain Model
// ════════════════════════════════════════════════════════════════════════════

// ── Tenancy ─────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique // "mentors-international", "byu-sandbox"
  name        String
  settings    Json?    // org-level defaults (terminology, branding, etc.)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships  OrganizationMembership[]
  programs     Program[]
  participants ParticipantProfile[]
  mentors      MentorProfile[]
  metrics      MetricDefinition[]
  alertRules   AlertRule[]
  collections  ContentCollection[]
  ltiPlatforms LtiPlatform[]
  ltiContexts  LtiContext[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id") // references Mentor.id for now
  role           String   // "owner", "admin", "member"
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

// ── Programs ────────────────────────────────────────────────────────────────

enum ProgramVersionStatus {
  draft
  published
  archived
}

model Program {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  slug           String   // "colombia-pilot-2026"
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     ProgramVersion[]
  cohorts      Cohort[]
  memberships  ProgramMembership[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("programs")
}

/// Binds a user to a single program they may configure.
///
/// Program-level rather than collection-level on purpose: a program owns its
/// version lineage, while one ContentCollection can be referenced by several
/// ProgramVersions (live data has an archived 1.0.0 and a published 1.1.0
/// sharing a collection). Binding to the collection would make "which version
/// may this person publish" ambiguous.
model ProgramMembership {
  id        String   @id @default(uuid())
  programId String   @map("program_id")
  userId    String   @map("user_id") // references Mentor.id, as OrganizationMembership does
  role      String   // "course_lead"
  createdAt DateTime @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([userId])
  @@index([programId])
  @@map("program_memberships")
}

model ProgramVersion {
  id           String               @id @default(uuid())
  programId    String               @map("program_id")
  version      String               // "1.0", "1.1-beta"
  config       Json                 // JourneyPackage.config validated by zod, not Prisma
  metadata     Json?                // complete JourneyPackage.metadata, including delivery
  status       ProgramVersionStatus @default(draft)
  primaryLang  String               @default("es") @map("primary_lang") // from metadata.languages[0]
  collectionId String?              @map("collection_id") // FK to ContentCollection
  active       Boolean              @default(false) // deprecated: use status == published
  publishedAt  DateTime?            @map("published_at")
  publishedBy  String?              @map("published_by") // user ID who published
  createdAt    DateTime             @default(now()) @map("created_at")

  program    Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  collection ContentCollection? @relation(fields: [collectionId], references: [id])
  cohorts    Cohort[]
  enrollments Enrollment[]
  diagnosticAttempts DiagnosticAttempt[]
  ltiContexts LtiContext[]

  @@unique([programId, version])
  @@index([programId, status])
  @@index([programId, active])
  @@map("program_versions")
}

model Cohort {
  id               String    @id @default(uuid())
  programId        String    @map("program_id")
  programVersionId String?   @map("program_version_id")
  slug             String    // "2026-q1"
  name             String
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  programVersion ProgramVersion? @relation(fields: [programVersionId], references: [id])
  enrollments    Enrollment[]
  invitations    EnrollmentInvitation[]
  ltiContexts    LtiContext[]

  @@unique([programId, slug])
  @@index([programId])
  @@map("cohorts")
}

/// `collectionKey` is a denormalized course identity, derived from
/// `programVersionId` -> `ProgramVersion.collectionId` -> `ContentCollection.slug`.
/// It exists because a course spans multiple ProgramVersions over time and
/// `participantId` (the learner identity Enrollment already keys on — there is
/// no separate `learnerId`) + `programVersionId` alone cannot express "one
/// ACTIVE enrollment per learner per COURSE" (see the partial unique index
/// below). It must be kept in sync with `programVersionId` by every writer;
/// the only live writer is `resolveOrCreateActiveEnrollment`
/// (Platform Restructure Phase A, Stage 1/2) — do not write this column
/// anywhere else. Nullable because `programVersionId` itself is nullable and
/// a handful of pre-Stage-2 rows point at a draft ProgramVersion with no
/// collection at all.
model Enrollment {
  id               String    @id @default(uuid())
  participantId    String    @map("participant_id")
  cohortId         String    @map("cohort_id")
  programVersionId String?   @map("program_version_id")
  collectionKey    String?   @map("collection_key")
  status           String    @default("active") // "active", "paused", "completed", "dropped"
  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  completedAt      DateTime? @map("completed_at")
  projectSelectionGrandfatheredAt DateTime? @map("project_selection_grandfathered_at")
  metadata         Json?

  participant    ParticipantProfile @relation(fields: [participantId], references: [id], onDelete: Cascade)
  cohort         Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  programVersion ProgramVersion?    @relation(fields: [programVersionId], references: [id])
  observations   MetricObservation[]
  alerts         Alert[]
  learnerProjects LearnerProject[]
  blockProgress      BlockProgress[]
  milestoneProgress  MilestoneProgress[]
  assessmentSessions AssessmentSession[]

  @@unique([participantId, cohortId])
  @@index([cohortId])
  @@index([participantId])
  // Partial unique index enforcing "one ACTIVE enrollment per (learner,
  // course)" (D2) lives in raw migration SQL, not here — Prisma schema syntax
  // cannot express a WHERE clause on an index. See
  // 20260821000000_add_enrollment_collection_key/migration.sql, following the
  // learner_projects_current_enrollment_key precedent
  // (20260814010000_add_learner_projects/migration.sql).
  @@map("enrollments")
}

enum LearnerProjectStatus {
  DRAFT
  ACTIVE
  CHANGED
  ABANDONED
}

/// The learner-authored project selection for one enrollment. Historical
/// CHANGED/ABANDONED rows are retained; raw migration SQL enforces at most one
/// current (DRAFT or ACTIVE) row because Prisma cannot express partial indexes.
model LearnerProject {
  id              String               @id @default(uuid())
  organizationId  String               @map("organization_id")
  enrollmentId    String               @map("enrollment_id")
  socioId         String               @map("socio_id")
  presetKey       String?              @map("preset_key")
  title           String?
  oneLiner        String?              @map("one_liner")
  context         String?
  automationLevel String?              @map("automation_level")
  interests       String[]
  status          LearnerProjectStatus @default(DRAFT)
  lifeContext     String?              @map("life_context")
  reframedAt      DateTime?            @map("reframed_at")
  automationValidatedAt DateTime?      @map("automation_validated_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  confirmedAt     DateTime?            @map("confirmed_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([socioId])
  @@index([enrollmentId])
  @@map("learner_projects")
}

model EnrollmentInvitation {
  id        String    @id @default(uuid())
  cohortId  String    @map("cohort_id")
  channel   String    // "whatsapp", "email", "sms"
  target    String    // phone number or email
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([token])
  @@map("enrollment_invitations")
}

// ── People ──────────────────────────────────────────────────────────────────

model ParticipantProfile {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  socioId        String?  @unique @map("socio_id") // FK to legacy Socio for migration
  displayName    String?  @map("display_name")
  preferredLang  String   @default("es") @map("preferred_lang")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socio         Socio?                  @relation(fields: [socioId], references: [id])
  enrollments   Enrollment[]

  @@index([organizationId])
  @@map("participant_profiles")
}

model MentorProfile {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  mentorId       String?  @unique @map("mentor_id") // FK to legacy Mentor for migration
  displayName    String?  @map("display_name")
  specialties    String[] @default([])
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentor       Mentor?                 @relation(fields: [mentorId], references: [id])
  alertReviews AlertReview[]

  @@index([organizationId])
  @@map("mentor_profiles")
}

// ── Content ─────────────────────────────────────────────────────────────────

model ContentCollection {
