  createdAt   DateTime  @default(now()) @map("created_at")

  lesson ContentLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, version, lang])
  @@index([lessonId, active])
  @@map("lesson_versions")
}

/// Current-version progress for player blocks. LessonProgress remains the
/// compatibility aggregate and is intentionally not changed by this model.
model BlockProgress {
  id             String    @id @default(uuid())
  /// DEPRECATED (A.6 candidate, Platform Restructure Phase A / A.4): learner
  /// identity is now reachable via enrollmentId -> participant -> socioId.
  /// Kept for one full verification cycle; new code should prefer
  /// enrollmentId. Not dropped here — A.6 is a separate migration.
  socioId        String    @map("socio_id")
  /// DEPRECATED (A.6 candidate): course identity is now enrollmentId's FK
  /// chain (programVersionId -> collectionId -> slug), set once at row
  /// creation and never rewritten on update (see A.4 write-path notes on
  /// completeBlock/recordPlayerTutorSuccess/markTeachBackComplete). Kept for
  /// one full verification cycle.
  collectionKey  String    @map("collection_key")
  lessonKey      String    @map("lesson_key")
  blockId        String    @map("block_id")
  contentVersion Int       @default(1) @map("content_version")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  score          Float?
  response       Json?
  state          Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// A.4. Nullable: backfilled rows and any row from before this stage may
  /// have none. Set once at creation by the three write paths in
  /// player/service.ts; never rewritten by an update — see the doc comment
  /// on `collectionKey` above for why, and the retake-collision note this
  /// implies (@@unique below is not yet enrollment-scoped; A.6's job).
  enrollmentId   String?   @map("enrollment_id")

  socio      Socio       @relation(fields: [socioId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // NOT YET enrollment-scoped — see A.4 report. A second enrollment in the
  // same collection (a retake) writing the same (lessonKey, blockId) would
  // collide with this constraint and overwrite the first attempt's row
  // instead of creating a new one. A.6 must widen this to include
  // enrollmentId before retakes are safe.
  @@unique([socioId, collectionKey, lessonKey, blockId], map: "block_progress_identity_key")
  @@index([socioId, collectionKey, completedAt])
  @@index([enrollmentId])
  @@map("block_progress")
}

/// Append-only baseline attempts; retakes never overwrite earlier evidence.
model DiagnosticAttempt {
  id               String   @id @default(uuid())
  socioId          String   @map("socio_id")
  programVersionId String   @map("program_version_id")
  collectionKey    String   @map("collection_key")
  answers          Json
  dimensionScores  Json     @map("dimension_scores")
  overallScore     Float    @map("overall_score")
  completedAt      DateTime @default(now()) @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  socio          Socio          @relation(fields: [socioId], references: [id], onDelete: Cascade)
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)

  @@index([socioId, collectionKey, completedAt])
  @@index([programVersionId])
  @@map("diagnostic_attempts")
}

// ── Measurement ─────────────────────────────────────────────────────────────

enum ObservationSource {
  self_reported
  human_recorded
  system_observed
  calculated
  ai_inferred
}

model MetricDefinition {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String   // "comprehension", "loan_repayment_pct"
  name           String
  description    String?
  category       String   // "learning", "financial", "behavioral", "emotional"
  dataType       String   @map("data_type") // "continuous", "ordinal", "categorical", "boolean"
  scale          Json?    // { min: 0, max: 10 } or { levels: ["low","medium","high"] }
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  observations MetricObservation[]
  alertRules   AlertRule[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("metric_definitions")
}

model MetricObservation {
  id                 String            @id @default(uuid())
  metricId           String            @map("metric_id")
  enrollmentId       String?           @map("enrollment_id")
  signalType         String            @map("signal_type") // "point", "delta", "event"
  value              Float
  confidence         Float?            // 0-1
  evidenceRefs       Json?             @map("evidence_refs") // { messageIds: [...], lessonKey: "..." }
  modelVersion       String?           @map("model_version")
  promptVersion      String?           @map("prompt_version")
  verificationStatus String?           @map("verification_status") // "unverified", "mentor_confirmed", "disputed"
  source             ObservationSource
  observedAt         DateTime          @map("observed_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  metric     MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  enrollment Enrollment?      @relation(fields: [enrollmentId], references: [id])

  @@index([metricId, observedAt])
  @@index([enrollmentId, observedAt])
  @@map("metric_observations")
}

model AlertRule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  metricId       String   @map("metric_id")
  name           String
  operator       String   // "lt", "gt", "eq", "delta_lt", "delta_gt"
  threshold      Float
  severity       String   // "low", "medium", "high", "critical"
  cooldownHours  Int      @default(24) @map("cooldown_hours")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@index([organizationId, active])
  @@index([metricId])
  @@map("alert_rules")
}

model Alert {
  id           String    @id @default(uuid())
  ruleId       String    @map("rule_id")
  enrollmentId String    @map("enrollment_id")
  severity     String    // copied from rule at trigger time
  triggerValue Float     @map("trigger_value")
  message      String?
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  rule       AlertRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  enrollment Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reviews    AlertReview[]

  @@index([ruleId, createdAt])
  @@index([enrollmentId, resolvedAt])
  @@map("alerts")
}

model AlertReview {
  id         String   @id @default(uuid())
  alertId    String   @map("alert_id")
  reviewerId String   @map("reviewer_id")
  action     String   // "acknowledged", "escalated", "resolved", "dismissed"
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  alert    Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  reviewer MentorProfile @relation(fields: [reviewerId], references: [id])

  @@index([alertId])
  @@index([reviewerId])
  @@map("alert_reviews")
}

enum AssessmentSessionStatus {
  pending
  in_progress
  completed
}

model AssessmentSession {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  /// DEPRECATED (A.6 candidate, A.4): see BlockProgress.socioId's doc comment.
  socioId        String                  @map("socio_id")
  /// This table has no collectionKey column at all — course identity had to
  /// be derived (A.4) via lessonKey -> ContentLesson.collection.slug,
  /// narrowed by the socio's curriculumCollectionKey at write/backfill time.
  /// lessonKey itself is NOT deprecated — it identifies which lesson this
  /// session is about, which enrollmentId cannot express and A.6 will not
  /// remove. Only its former role as the sole (indirect) course signal is
  /// superseded.
  lessonKey      String                  @map("lesson_key")
  blockId        String?                 @map("block_id")
  kind           String                  @default("teach_back")
  status         AssessmentSessionStatus @default(pending)
  attemptNumber  Int                     @default(1) @map("attempt_number")
  turnCount      Int                     @default(0) @map("turn_count")
  liveState      Json?                   @map("live_state")
  scores         Json?
  passedAt       DateTime?               @map("passed_at")
  completedAt    DateTime?               @map("completed_at")
  configSnapshot Json?                   @map("config_snapshot")
  channel        String                  @default("web")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  /// A.4. Nullable — see BlockProgress.enrollmentId's doc comment. Set once
  /// at creation (createAssessmentSession); this table has no update path
  /// that could rewrite it.
  enrollmentId   String?                 @map("enrollment_id")

  socio      Socio       @relation(fields: [socioId], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  messages   Message[]

  // attemptNumber already differentiates retakes (a new attempt increments
  // it), so — unlike BlockProgress/MilestoneProgress — a second enrollment
  // does not collide with this constraint. It is still not enrollment-aware:
  // attemptNumber's counter continues across enrollments rather than
  // resetting per-enrollment, a related but different gap. See A.4 report.
  @@unique([socioId, lessonKey, attemptNumber])
  @@index([organizationId])
  @@index([socioId, status])
  @@index([enrollmentId])
  @@map("assessment_sessions")
}

/// Per-participant milestone attainment.
///
/// `outcome.milestones` (ProgramVersion.config) declares WHICH milestones a
/// course has and, via `afterLessonKey`, where each becomes checkable. This
/// table records that a specific participant reached one.
///
/// Deliberately separate from LessonProgress: completing a lesson means the
/// learner was TAUGHT something, whereas reaching a milestone means they DID
/// something. Before this table the system had no signal of the second kind at
/// all — it could tell you what a learner had been taught and how well they
/// articulated it, and nothing about whether they had tried anything.
///
/// `checkDescription` on a milestone is conversational ("Learner reports
/// completing the exercise"), so the writer is a [MILESTONE:key] marker the AI
/// emits, the same mechanism as [LESSON_COMPLETE:n] and [FINANCIAL:...].
///
/// enrollmentId landed in A.4 (Platform Restructure Phase A). The identity
/// below is NOT yet enrollment-scoped — see the @@unique comment — so this
/// is still a retake blocker until A.6 widens that constraint; only the
/// column existing is done, not the fix.
model MilestoneProgress {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  /// DEPRECATED (A.6 candidate, A.4): see BlockProgress.socioId's doc comment.
  socioId        String   @map("socio_id")
  /// Scopes the milestone key: keys are unique per course, not globally.
  /// DEPRECATED (A.6 candidate, A.4): see BlockProgress.collectionKey's doc
  /// comment — same "set once at creation, never rewritten" rule applies.
  collectionKey  String   @map("collection_key")
  milestoneKey   String   @map("milestone_key")
  reachedAt      DateTime @default(now()) @map("reached_at")
  /// "ai_marker" | "mentor_confirmed"
  source         String   @default("ai_marker")
  /// The learner's own report, verbatim. Never rendered into a prompt.
  evidence       String?
  createdAt      DateTime @default(now()) @map("created_at")
  /// A.4. Nullable — see BlockProgress.enrollmentId's doc comment; the same
  /// rules apply (set once by recordMilestoneReached, never rewritten;
  /// `update: {}` on its upsert already never touched anything).
  enrollmentId   String?  @map("enrollment_id")

  socio      Socio       @relation(fields: [socioId], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // NOT YET enrollment-scoped — see the model doc comment above and the A.4
  // report. Same retake-collision shape as BlockProgress: a second
  // enrollment in this collection reaching the same milestoneKey would hit
  // this constraint's `update: {}` no-op instead of recording a fresh reach.
  @@unique([socioId, collectionKey, milestoneKey])
  @@index([organizationId])
  @@index([socioId, collectionKey])
  @@index([enrollmentId])
  @@map("milestone_progress")
}

model LtiPlatform {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  issuer           String
  clientId         String   @map("client_id")
  authorizationUrl String   @map("authorization_url")
  tokenUrl         String   @map("token_url")
  jwksUrl          String   @map("jwks_url")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deployments  LtiDeployment[]
  identities   LtiIdentity[]

  @@unique([issuer, clientId])
  @@index([organizationId])
  @@map("lti_platforms")
}

model LtiDeployment {
  id           String   @id @default(uuid())
  platformId   String   @map("platform_id")
  deploymentId String   @map("deployment_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  platform LtiPlatform   @relation(fields: [platformId], references: [id], onDelete: Cascade)
  contexts LtiContext[]
  tokens   LtiOneTimeToken[]

  @@unique([platformId, deploymentId])
  @@map("lti_deployments")
}

model LtiContext {
  id               String   @id @default(uuid())
  deploymentId     String   @map("deployment_id")
  contextId        String   @map("context_id")
  organizationId   String   @map("organization_id")
  programVersionId String   @map("program_version_id")
  cohortId         String   @map("cohort_id")
  title            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  deployment     LtiDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  programVersion ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  cohort         Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  enrollments    LtiEnrollment[]
  resourceLinks  LtiResourceLink[]
  sessions       LtiSession[]

  @@unique([deploymentId, contextId])
  @@index([organizationId])
  @@map("lti_contexts")
}

/// Canvas subject is canonical within a platform. It can point at both a
/// learner and instructor account when roles change; email is never an identity key.
model LtiIdentity {
  id         String   @id @default(uuid())
  platformId String   @map("platform_id")
  subject    String
  socioId    String?  @map("socio_id")
  mentorId   String?  @map("mentor_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  platform   LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  socio      Socio? @relation(fields: [socioId], references: [id])
  mentor     Mentor? @relation(fields: [mentorId], references: [id])
  enrollments LtiEnrollment[]
  sessions    LtiSession[]

  @@unique([platformId, subject])
  @@index([socioId])
  @@index([mentorId])
  @@map("lti_identities")
}

/// Not a duplicate of `Enrollment` (course enrollment): this tracks LTI
/// role-membership per launch context (learner/instructor in this Canvas
/// context), deduped so repeated launches don't re-write it. 0 rows and
/// 0 `LtiContext` rows as of 2026-08-21 — not dead code, just unconfigured:
/// `provisionLaunch` writes it on every launch, and no LTI context has been
/// configured yet. NOT an A.6 drop candidate — it has a live writer and a
/// distinct purpose from `Enrollment`; the earlier note suggesting otherwise
/// was wrong and is retracted. Canvas/LTI has no deadline and resumes after
/// Phase E per the restructure plan.
model LtiEnrollment {
  id         String   @id @default(uuid())
  identityId String   @map("identity_id")
  contextId  String   @map("context_id")
  role       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  identity LtiIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  context  LtiContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([identityId, contextId, role])
  @@index([contextId])
  @@map("lti_enrollments")
}

model LtiResourceLink {
  id             String   @id @default(uuid())
  contextId      String   @map("context_id")
  resourceLinkId String   @map("resource_link_id")
  resourceType   String   @map("resource_type") // course | lesson | capstone
  lessonKey      String?  @map("lesson_key")
  lineItemUrl    String?  @map("line_item_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  context LtiContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  gradeDeliveries LtiGradeDelivery[]

  @@unique([contextId, resourceLinkId])
  @@map("lti_resource_links")
}

model LtiOneTimeToken {
  id            String    @id @default(uuid())
  deploymentId  String?   @map("deployment_id")
  tokenHash     String    @unique @map("token_hash")
  purpose       String    // state | nonce
  targetLinkUri String    @map("target_link_uri")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  deployment LtiDeployment? @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([purpose, expiresAt])
  @@map("lti_one_time_tokens")
}

model LtiSession {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @map("token_hash")
  exchangeTokenHash String @unique @map("exchange_token_hash")
  identityId String   @map("identity_id")
  contextId  String   @map("context_id")
  role       String   // learner | instructor for this launch
  destination String
  expiresAt  DateTime @map("expires_at")
  exchangedAt DateTime? @map("exchanged_at")
  launchData Json?    @map("launch_data")
  createdAt  DateTime @default(now()) @map("created_at")

  identity LtiIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  context  LtiContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("lti_sessions")
}

model LtiGradeDelivery {
  id             String    @id @default(uuid())
  resourceLinkId String    @map("resource_link_id")
  socioId        String    @map("socio_id")
  milestoneCount Int       @map("milestone_count")
  scoreGiven     Float     @map("score_given")
  status         String    @default("pending") // pending | delivering | delivered | failed
  attemptCount   Int       @default(0) @map("attempt_count")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  lastError      String?   @map("last_error")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  resourceLink LtiResourceLink @relation(fields: [resourceLinkId], references: [id], onDelete: Cascade)
  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@unique([resourceLinkId, socioId, milestoneCount])
  @@index([status, nextAttemptAt])
  @@map("lti_grade_deliveries")
}

model AiInvocation {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now()) @map("created_at")
  organizationId      String?  @map("organization_id")
  socioId             String?  @map("socio_id")
  assessmentSessionId String?  @map("assessment_session_id")
  // Free-form string, not an enum: a new operation must not require a migration.
  // lesson_delivery | assessment_turn | sensing | assessment_sensing | sentiment
  // | summary | onboarding
  operation           String
  mode                String?
  model               String
  promptTokensApprox  Int?     @map("prompt_tokens_approx")
  responseLength      Int?     @map("response_length")
  // Structured call-site context (player course/version/lesson/block/intent).
  context             Json?
  // Provider termination reason when LangChain exposes one (stop, length, ...).
  finishReason        String?  @map("finish_reason")
  latencyMs           Int      @map("latency_ms")
  // Time to first token. Only streamed calls set it; every non-streaming call
  // and every pre-existing row leaves it null. A real column, not a
  // promptVersion JSON key, so latency dashboards can aggregate on it.
  ttftMs              Int?     @map("ttft_ms")
  // { core, context, task, content, language, evaluator } - whatever subset applies
  promptVersion       Json     @map("prompt_version")
  promptHash          String   @map("prompt_hash")
  // Full assembled prompt, stored ONLY when AI_TRACE=full
  promptText          String?  @map("prompt_text")
  success             Boolean
  errorMessage        String?  @map("error_message")

  @@index([operation, createdAt])
  @@index([socioId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_invocations")
}
