  organizationId String   @map("organization_id")
  slug           String   // "mi-colombia-curriculum"
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lessons         ContentLesson[]
  programVersions ProgramVersion[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("content_collections")
}

model ContentLesson {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  slug         String   // "lesson-01-costs"
  orderIndex   Int      @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection ContentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  versions   LessonVersion[]

  @@unique([collectionId, slug])
  @@index([collectionId, orderIndex])
