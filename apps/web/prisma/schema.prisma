generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemPrompt {
  id        String   @id @default(uuid())
  version   String   // e.g., "1.0", "1.1-beta"
  content   String
  category  String   // e.g., "onboarding", "mentor_support"
  active    Boolean  @default(false)
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, active])
  @@map("system_prompts")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String // "info", "warn", "error"
  category  String // "ai", "webhook", "auth", "cron", "system"
  message   String
  metadata  String? // JSON string
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, createdAt])
  @@index([level, createdAt])
  @@map("system_logs")
}

enum OnboardingStatus {
  NEW
  AWAITING_LANGUAGE
  AWAITING_CONSENT
  AWAITING_NAME
  AWAITING_BUSINESS
  ACTIVE
}

model Socio {
  id                  String           @id @default(uuid())
  whatsappPhoneNumber String?          @unique @map("whatsapp_phone_number")
  channelType         String           @default("whatsapp") @map("channel_type")
  externalId          String           @default("") @map("external_id")
  language            String           @default("es") @map("language")
  passwordHash        String?          @map("password_hash")
  name                String?
  businessName        String?          @map("business_name")
  businessDescription String?          @map("business_description")
  status              OnboardingStatus @default(NEW)
  promptOverrides     Json?            @map("prompt_overrides")
  aiPaused            Boolean          @default(false) @map("ai_paused")
  metadata            Json?
  mentorId            String?          @map("mentor_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  mentor     Mentor?   @relation(fields: [mentorId], references: [id])
  messages   Message[]
  summaries  Summary[]
  progress   SocioProgress?
  flags      SocioFlag[]
  lessonProgress LessonProgress[]
  sentiments MessageSentiment[]
  financialSnapshots FinancialSnapshot[]
  context            SocioContext?
  feedback           SocioFeedback[]
  dimensionStates    SocioDimensionState[]

  @@unique([channelType, externalId], map: "socios_channel_external_id_key")
  @@index([mentorId, status])
  @@index([status, updatedAt])
  @@map("socios")
}

model SocioFeedback {
  id        String   @id @default(uuid())
  socioId   String   @map("socio_id")
  lessonNum Int      @map("lesson_num")
  rating    Int?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId, lessonNum])
  @@map("socio_feedback")
}

model Mentor {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  role               String   // "mentor", "admin"
  preferredLanguage  String   @default("en") @map("preferred_language")
  createdAt          DateTime @default(now()) @map("created_at")

  socios Socio[]

  @@map("mentors")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("password_reset_tokens")
}

model ProgramConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // JSON-encoded
  type        String   // "number", "boolean", "string", "json"
  label       String   // Human-readable label for the UI
  description String?
  category    String   // "lesson_pacing", "ai_behavior", "flagging", "reminders", "onboarding"
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_config")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String   // "changed_config", "updated_prompt", "activated_prompt", "resolved_flag", "assigned_mentor"
  targetType String   @map("target_type") // "program_config", "system_prompt", "socio", "mentor"
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

model Feedback {
  id        String   @id @default(uuid())
  page      String   // which page the feedback is about
  subject   String   // short subject line
  body      String   // full feedback text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

model Message {
  id         String   @id @default(uuid())
  socioId    String   @map("socio_id")
  role       String   // "user", "assistant", "system"
  content    String
  senderType String?  @map("sender_type") // "ai", "mentor", null (legacy)
  createdAt  DateTime @default(now()) @map("created_at")

  socio     Socio              @relation(fields: [socioId], references: [id])
  sentiment MessageSentiment?

  @@index([socioId, createdAt])
  @@map("messages")
}

model SocioProgress {
  id                    String    @id @default(uuid())
  socioId               String    @unique @map("socio_id")
  currentLessonNumber   Int       @default(1) @map("current_lesson_number")
  currentMessageIndex   Int       @default(0) @map("current_message_index")
  completedLessons      Int[]     @default([]) @map("completed_lessons")
  weeklyUnderstanding   Int?      @map("weekly_understanding")
  weeklyImplementation  Int?      @map("weekly_implementation")
  lastLessonCompletedAt DateTime? @map("last_lesson_completed_at")
  remindersSent         Int       @default(0) @map("reminders_sent")
  lastInteractionAt     DateTime? @map("last_interaction_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("socio_progress")
}

model Summary {
  id            String   @id @default(uuid())
  socioId       String   @map("socio_id")
  weekStartDate DateTime @map("week_start_date")
  content       String
  flags         Json?
  metrics       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@index([socioId, weekStartDate])
  @@map("summaries")
}

model SocioFlag {
  id         String    @id @default(uuid())
  socioId    String    @map("socio_id")
  level      String    // "RED" | "YELLOW"
  reason     String
  source     String    @default("ai_marker") // "ai_marker", "sentiment_auto", "mentor_manual"
  resolved   Boolean   @default(false)
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  messageId  String?   @map("message_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@index([socioId, resolved])
  @@index([resolved, level, createdAt])
  @@map("socio_flags")
}

model LessonProgress {
  id                  String    @id @default(uuid())
  socioId             String    @map("socio_id")
  lessonNumber        Int       @map("lesson_number")
  understanding       Int?
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@unique([socioId, lessonNumber], map: "lesson_progress_socio_lesson_key")
  @@index([socioId, completedAt])
  @@map("lesson_progress")
}

model MessageSentiment {
  id          String   @id @default(uuid())
  messageId   String   @unique @map("message_id")
  socioId     String   @map("socio_id")
  confusion   Int      // 0-10
  frustration Int      // 0-10
  urgency     Int      // 0-10
  sentiment   String   // "positive", "neutral", "negative", "distressed"
  topics      String[] // e.g. ["finances", "business", "personal"]
  createdAt   DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id])
  socio   Socio   @relation(fields: [socioId], references: [id])

  @@index([socioId, createdAt])
  @@index([sentiment, createdAt])
  @@map("message_sentiments")
}

model SocioContext {
  id               String   @id @default(uuid())
  socioId          String   @unique @map("socio_id")
  businessType     String?  @map("business_type")
  products         String?  @map("products")
  monthlyRevenue   String?  @map("monthly_revenue")
  monthlyExpenses  String?  @map("monthly_expenses")
  numEmployees     String?  @map("num_employees")
  location         String?  @map("location")
  challenges       String?  @map("challenges")
  goals            String?  @map("goals")
  familyContext    String?  @map("family_context")
  customFacts      String?  @map("custom_facts")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("socio_contexts")
}

model FinancialSnapshot {
  id            String   @id @default(uuid())
  socioId       String   @map("socio_id")
  weekStartDate DateTime @map("week_start_date")
  revenue       Float
  netProfit     Float    @map("net_profit")
  source        String   @default("ai_marker") // "ai_marker", "manual", "cron"
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@unique([socioId, weekStartDate], map: "financial_snapshot_socio_week_key")
  @@index([socioId, weekStartDate])
  @@map("financial_snapshots")
}

model SocioDimensionState {
  id            String   @id @default(cuid())
  socioId       String   @map("socio_id")
  dimensionKey  String   @map("dimension_key") // "comprehension" | "confusion" (matches DIMENSION_DEFINITIONS)
  level         Float    // 0-10, continuous
  trend         String   // "improving" | "flat" | "declining"
  confidence    Float    // 0-1, sensing model's certainty
  evidence      String?  // short excerpt/summary backing this update
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@unique([socioId, dimensionKey], map: "socio_dimension_state_unique")
  @@index([socioId])
  @@map("socio_dimension_states")
}
