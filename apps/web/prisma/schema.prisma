generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemPrompt {
  id        String   @id @default(uuid())
  version   String   // e.g., "1.0", "1.1-beta"
  content   String
  category  String   // e.g., "onboarding", "mentor_support"
  active    Boolean  @default(false)
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_prompts")
}

enum OnboardingStatus {
  NEW
  AWAITING_CONSENT
  AWAITING_NAME
  ACTIVE
}

model Socio {
  id                  String           @id @default(uuid())
  whatsappPhoneNumber String           @unique @map("whatsapp_phone_number")
  name                String?
  businessName        String?          @map("business_name")
  businessDescription String?          @map("business_description")
  status              OnboardingStatus @default(NEW)
  promptOverrides     Json?            @map("prompt_overrides")
  metadata            Json?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  messages  Message[]
  summaries Summary[]
  progress  SocioProgress?

  @@map("socios")
}

model Mentor {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   // "mentor", "admin"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mentors")
}

model Message {
  id        String   @id @default(uuid())
  socioId   String   @map("socio_id")
  role      String   // "user", "assistant", "system"
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("messages")
}

model SocioProgress {
  id                    String    @id @default(uuid())
  socioId               String    @unique @map("socio_id")
  currentLessonNumber   Int       @default(1) @map("current_lesson_number")
  currentMessageIndex   Int       @default(0) @map("current_message_index")
  completedLessons      Int[]     @default([]) @map("completed_lessons")
  weeklyUnderstanding   Int?      @map("weekly_understanding")
  weeklyImplementation  Int?      @map("weekly_implementation")
  lastLessonCompletedAt DateTime? @map("last_lesson_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("socio_progress")
}

model Summary {
  id            String   @id @default(uuid())
  socioId       String   @map("socio_id")
  weekStartDate DateTime @map("week_start_date")
  content       String
  flags         Json?
  metrics       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("summaries")
}
