generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemPrompt {
  id        String   @id @default(uuid())
  version   String   // e.g., "1.0", "1.1-beta"
  content   String
  // One of PROMPT_CATEGORIES in src/lib/ai/prompts/categories.ts
  category  String
  active    Boolean  @default(false)
  authorId  String   @map("author_id")
  // Scope: null means "applies more broadly". Resolution walks
  //   (org, collection) -> (org, null) -> (null, null) -> code constant
  // so an unscoped row keeps behaving exactly as it did before scoping existed.
  organizationId String? @map("organization_id")
  // ContentCollection.slug, matching Socio.curriculumCollectionKey. Replaces
  // the old `category = "core:{collectionKey}"` string-namespacing hack.
  collectionKey  String? @map("collection_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, active])
  @@index([organizationId, collectionKey, category, active])
  @@map("system_prompts")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String // "info", "warn", "error"
  category  String // "ai", "webhook", "auth", "cron", "system"
  message   String
  metadata  String? // JSON string
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, createdAt])
  @@index([level, createdAt])
  @@map("system_logs")
}

enum OnboardingStatus {
  NEW
  AWAITING_LANGUAGE
  AWAITING_CONSENT
  AWAITING_NAME
  AWAITING_BUSINESS
  ACTIVE
}

model Socio {
  id                  String           @id @default(uuid())
  whatsappPhoneNumber String?          @unique @map("whatsapp_phone_number")
  channelType         String           @default("whatsapp") @map("channel_type")
  externalId          String           @default("") @map("external_id")
  language            String           @default("es") @map("language")
  passwordHash        String?          @map("password_hash")
  name                String?
  businessName        String?          @map("business_name")
  businessDescription String?          @map("business_description")
  status              OnboardingStatus @default(NEW)
  promptOverrides     Json?            @map("prompt_overrides")
  aiPaused            Boolean          @default(false) @map("ai_paused")
  metadata            Json?
  mentorId            String?          @map("mentor_id")
  curriculumCollectionKey String?      @map("curriculum_collection_key")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  mentor     Mentor?   @relation(fields: [mentorId], references: [id])
  messages   Message[]
  summaries  Summary[]
  progress   SocioProgress?
  flags      SocioFlag[]
  lessonProgress LessonProgress[]
  sentiments MessageSentiment[]
  financialSnapshots FinancialSnapshot[]
  context            SocioContext?
  feedback           SocioFeedback[]
  dimensionStates    SocioDimensionState[]
  participantProfile ParticipantProfile?
  assessmentSessions AssessmentSession[]

  @@unique([channelType, externalId], map: "socios_channel_external_id_key")
  @@index([mentorId, status])
  @@index([status, updatedAt])
  @@map("socios")
}

model SocioFeedback {
  id        String   @id @default(uuid())
  socioId   String   @map("socio_id")
  lessonNum Int      @map("lesson_num")
  rating    Int?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId, lessonNum])
  @@map("socio_feedback")
}

model Mentor {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  role               String   // "mentor", "admin"
  preferredLanguage  String   @default("en") @map("preferred_language")
  createdAt          DateTime @default(now()) @map("created_at")

  socios        Socio[]
  mentorProfile MentorProfile?

  @@map("mentors")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("password_reset_tokens")
}

model ProgramConfig {
  id          String   @id @default(uuid())
  key         String
  value       String   // JSON-encoded
  type        String   // "number", "boolean", "string", "json"
  label       String   // Human-readable label for the UI
  description String?
  category    String   // "lesson_pacing", "ai_behavior", "flagging", "reminders", "onboarding"
  // Scope: null means "applies more broadly", same three-tier walk as
  // SystemPrompt. `key` was globally unique before this, which is precisely
  // why two courses could not hold different values for it.
  organizationId String? @map("organization_id")
  collectionKey  String? @map("collection_key")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, collectionKey, key], map: "program_config_scope_key")
  @@index([organizationId, collectionKey])
  @@map("program_config")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String   // "changed_config", "updated_prompt", "activated_prompt", "resolved_flag", "assigned_mentor"
  targetType String   @map("target_type") // "program_config", "system_prompt", "socio", "mentor"
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

model Feedback {
  id        String   @id @default(uuid())
  page      String   // which page the feedback is about (user-selected)
  pagePath  String?  @map("page_path") // actual URL path, derived from Referer
  subject   String   // short subject line
  body      String   // full feedback text
  // Attribution is opportunistic: the feedback widget is deliberately available
  // logged-out, so all three are null for an anonymous report.
  userId    String?  @map("user_id")
  role      String?  // "socio" | "mentor" | "admin" — snapshot at submit time
  // Null unless the submitter is a socio whose org resolved at tier 1 or 2.
  // A tier-3 (DEFAULT_ORGANIZATION_ID) resolution writes null rather than
  // stamping a guess — same fail-closed rule as resolveDashboardPanels.
  organizationId String? @map("organization_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("feedback")
}

model Message {
  id         String   @id @default(uuid())
  socioId    String   @map("socio_id")
  role       String   // "user", "assistant", "system"
  content    String
  senderType String?  @map("sender_type") // "ai", "mentor", null (legacy)
  createdAt  DateTime @default(now()) @map("created_at")

  assessmentSessionId String? @map("assessment_session_id")
  metadata            Json?

  socio             Socio              @relation(fields: [socioId], references: [id])
  sentiment         MessageSentiment?
  assessmentSession AssessmentSession? @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)

  @@index([assessmentSessionId, createdAt])
  @@index([socioId, createdAt])
  @@map("messages")
}

model SocioProgress {
  id                    String    @id @default(uuid())
  socioId               String    @unique @map("socio_id")
  currentLessonNumber   Int       @default(1) @map("current_lesson_number")
  currentMessageIndex   Int       @default(0) @map("current_message_index")
  completedLessons      Int[]     @default([]) @map("completed_lessons")
  weeklyUnderstanding   Int?      @map("weekly_understanding")
  weeklyImplementation  Int?      @map("weekly_implementation")
  lastLessonCompletedAt DateTime? @map("last_lesson_completed_at")
  remindersSent         Int       @default(0) @map("reminders_sent")
  lastInteractionAt     DateTime? @map("last_interaction_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("socio_progress")
}

model Summary {
  id            String   @id @default(uuid())
  socioId       String   @map("socio_id")
  weekStartDate DateTime @map("week_start_date")
  content       String
  flags         Json?
  metrics       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@index([socioId, weekStartDate])
  @@map("summaries")
}

model SocioFlag {
  id         String    @id @default(uuid())
  socioId    String    @map("socio_id")
  level      String    // "RED" | "YELLOW"
  reason     String
  source     String    @default("ai_marker") // "ai_marker", "sentiment_auto", "mentor_manual"
  resolved   Boolean   @default(false)
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  messageId  String?   @map("message_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@index([socioId, resolved])
  @@index([resolved, level, createdAt])
  @@map("socio_flags")
}

model LessonProgress {
  id                  String    @id @default(uuid())
  socioId             String    @map("socio_id")
  lessonNumber        Int       @map("lesson_number")
  understanding       Int?
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@unique([socioId, lessonNumber], map: "lesson_progress_socio_lesson_key")
  @@index([socioId, completedAt])
  @@map("lesson_progress")
}

model MessageSentiment {
  id          String   @id @default(uuid())
  messageId   String   @unique @map("message_id")
  socioId     String   @map("socio_id")
  confusion   Int      // 0-10
  frustration Int      // 0-10
  urgency     Int      // 0-10
  sentiment   String   // "positive", "neutral", "negative", "distressed"
  topics      String[] // e.g. ["finances", "business", "personal"]
  createdAt   DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id])
  socio   Socio   @relation(fields: [socioId], references: [id])

  @@index([socioId, createdAt])
  @@index([sentiment, createdAt])
  @@map("message_sentiments")
}

model SocioContext {
  id               String   @id @default(uuid())
  socioId          String   @unique @map("socio_id")
  businessType     String?  @map("business_type")
  products         String?  @map("products")
  monthlyRevenue   String?  @map("monthly_revenue")
  monthlyExpenses  String?  @map("monthly_expenses")
  numEmployees     String?  @map("num_employees")
  location         String?  @map("location")
  challenges       String?  @map("challenges")
  goals            String?  @map("goals")
  familyContext    String?  @map("family_context")
  customFacts      String?  @map("custom_facts")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("socio_contexts")
}

model FinancialSnapshot {
  id            String   @id @default(uuid())
  socioId       String   @map("socio_id")
  weekStartDate DateTime @map("week_start_date")
  revenue       Float
  netProfit     Float    @map("net_profit")
  source        String   @default("ai_marker") // "ai_marker", "manual", "cron"
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id])

  @@unique([socioId, weekStartDate], map: "financial_snapshot_socio_week_key")
  @@index([socioId, weekStartDate])
  @@map("financial_snapshots")
}

model SocioDimensionState {
  id            String   @id @default(cuid())
  socioId       String   @map("socio_id")
  dimensionKey  String   @map("dimension_key") // "comprehension" | "confusion" (matches DIMENSION_DEFINITIONS)
  level         Float    // 0-10, continuous
  trend         String   // "improving" | "flat" | "declining"
  confidence    Float    // 0-1, sensing model's certainty
  evidence      String?  // short excerpt/summary backing this update
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@unique([socioId, dimensionKey], map: "socio_dimension_state_unique")
  @@index([socioId])
  @@map("socio_dimension_states")
}

// ════════════════════════════════════════════════════════════════════════════
// Phase 1: Generalized Domain Model
// ════════════════════════════════════════════════════════════════════════════

// ── Tenancy ─────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique // "mentors-international", "byu-sandbox"
  name        String
  settings    Json?    // org-level defaults (terminology, branding, etc.)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships  OrganizationMembership[]
  programs     Program[]
  participants ParticipantProfile[]
  mentors      MentorProfile[]
  metrics      MetricDefinition[]
  alertRules   AlertRule[]
  collections  ContentCollection[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id") // references Mentor.id for now
  role           String   // "owner", "admin", "member"
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

// ── Programs ────────────────────────────────────────────────────────────────

enum ProgramVersionStatus {
  draft
  published
  archived
}

model Program {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  slug           String   // "colombia-pilot-2026"
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     ProgramVersion[]
  cohorts      Cohort[]
  memberships  ProgramMembership[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("programs")
}

/// Binds a user to a single program they may configure.
///
/// Program-level rather than collection-level on purpose: a program owns its
/// version lineage, while one ContentCollection can be referenced by several
/// ProgramVersions (live data has an archived 1.0.0 and a published 1.1.0
/// sharing a collection). Binding to the collection would make "which version
/// may this person publish" ambiguous.
model ProgramMembership {
  id        String   @id @default(uuid())
  programId String   @map("program_id")
  userId    String   @map("user_id") // references Mentor.id, as OrganizationMembership does
  role      String   // "course_lead"
  createdAt DateTime @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([userId])
  @@index([programId])
  @@map("program_memberships")
}

model ProgramVersion {
  id           String               @id @default(uuid())
  programId    String               @map("program_id")
  version      String               // "1.0", "1.1-beta"
  config       Json                 // JourneyPackage.config validated by zod, not Prisma
  status       ProgramVersionStatus @default(draft)
  primaryLang  String               @default("es") @map("primary_lang") // from metadata.languages[0]
  collectionId String?              @map("collection_id") // FK to ContentCollection
  active       Boolean              @default(false) // deprecated: use status == published
  publishedAt  DateTime?            @map("published_at")
  publishedBy  String?              @map("published_by") // user ID who published
  createdAt    DateTime             @default(now()) @map("created_at")

  program    Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  collection ContentCollection? @relation(fields: [collectionId], references: [id])
  cohorts    Cohort[]
  enrollments Enrollment[]

  @@unique([programId, version])
  @@index([programId, status])
  @@index([programId, active])
  @@map("program_versions")
}

model Cohort {
  id               String    @id @default(uuid())
  programId        String    @map("program_id")
  programVersionId String?   @map("program_version_id")
  slug             String    // "2026-q1"
  name             String
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  programVersion ProgramVersion? @relation(fields: [programVersionId], references: [id])
  enrollments    Enrollment[]
  invitations    EnrollmentInvitation[]

  @@unique([programId, slug])
  @@index([programId])
  @@map("cohorts")
}

model Enrollment {
  id               String    @id @default(uuid())
  participantId    String    @map("participant_id")
  cohortId         String    @map("cohort_id")
  programVersionId String?   @map("program_version_id")
  status           String    @default("active") // "active", "paused", "completed", "dropped"
  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  completedAt      DateTime? @map("completed_at")
  metadata         Json?

  participant    ParticipantProfile @relation(fields: [participantId], references: [id], onDelete: Cascade)
  cohort         Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  programVersion ProgramVersion?    @relation(fields: [programVersionId], references: [id])
  observations   MetricObservation[]
  alerts         Alert[]

  @@unique([participantId, cohortId])
  @@index([cohortId])
  @@index([participantId])
  @@map("enrollments")
}

model EnrollmentInvitation {
  id        String    @id @default(uuid())
  cohortId  String    @map("cohort_id")
  channel   String    // "whatsapp", "email", "sms"
  target    String    // phone number or email
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([token])
  @@map("enrollment_invitations")
}

// ── People ──────────────────────────────────────────────────────────────────

model ParticipantProfile {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  socioId        String?  @unique @map("socio_id") // FK to legacy Socio for migration
  displayName    String?  @map("display_name")
  preferredLang  String   @default("es") @map("preferred_lang")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socio         Socio?                  @relation(fields: [socioId], references: [id])
  enrollments   Enrollment[]
  mentorships   MentoringRelationship[] @relation("ParticipantMentorships")

  @@index([organizationId])
  @@map("participant_profiles")
}

model MentorProfile {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  mentorId       String?  @unique @map("mentor_id") // FK to legacy Mentor for migration
  displayName    String?  @map("display_name")
  specialties    String[] @default([])
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentor       Mentor?                 @relation(fields: [mentorId], references: [id])
  mentorships  MentoringRelationship[]
  alertReviews AlertReview[]

  @@index([organizationId])
  @@map("mentor_profiles")
}

model MentoringRelationship {
  id            String    @id @default(uuid())
  mentorId      String    @map("mentor_profile_id")
  participantId String    @map("participant_id")
  role          String    @default("primary") // "primary", "backup", "observer"
  activeFrom    DateTime  @default(now()) @map("active_from")
  activeUntil   DateTime? @map("active_until")
  createdAt     DateTime  @default(now()) @map("created_at")

  mentorProfile MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  participant   ParticipantProfile @relation("ParticipantMentorships", fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([mentorId, participantId, role])
  @@index([mentorId])
  @@index([participantId])
  @@map("mentoring_relationships")
}

// ── Content ─────────────────────────────────────────────────────────────────

model ContentCollection {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  slug           String   // "mi-colombia-curriculum"
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lessons         ContentLesson[]
  programVersions ProgramVersion[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("content_collections")
}

model ContentLesson {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  slug         String   // "lesson-01-costs"
  orderIndex   Int      @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection ContentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  versions   LessonVersion[]

  @@unique([collectionId, slug])
  @@index([collectionId, orderIndex])
  @@map("content_lessons")
}

model LessonVersion {
  id          String    @id @default(uuid())
  lessonId    String    @map("lesson_id")
  version     String    // "1.0"
  lang        String    @default("es")
  title       String
  body        Json      // JourneyPackage lesson block, validated by zod
  active      Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  lesson ContentLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, version, lang])
  @@index([lessonId, active])
  @@map("lesson_versions")
}

// ── Measurement ─────────────────────────────────────────────────────────────

enum ObservationSource {
  self_reported
  human_recorded
  system_observed
  calculated
  ai_inferred
}

model MetricDefinition {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String   // "comprehension", "loan_repayment_pct"
  name           String
  description    String?
  category       String   // "learning", "financial", "behavioral", "emotional"
  dataType       String   @map("data_type") // "continuous", "ordinal", "categorical", "boolean"
  scale          Json?    // { min: 0, max: 10 } or { levels: ["low","medium","high"] }
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  observations MetricObservation[]
  alertRules   AlertRule[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("metric_definitions")
}

model MetricObservation {
  id                 String            @id @default(uuid())
  metricId           String            @map("metric_id")
  enrollmentId       String?           @map("enrollment_id")
  signalType         String            @map("signal_type") // "point", "delta", "event"
  value              Float
  confidence         Float?            // 0-1
  evidenceRefs       Json?             @map("evidence_refs") // { messageIds: [...], lessonKey: "..." }
  modelVersion       String?           @map("model_version")
  promptVersion      String?           @map("prompt_version")
  verificationStatus String?           @map("verification_status") // "unverified", "mentor_confirmed", "disputed"
  source             ObservationSource
  observedAt         DateTime          @map("observed_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  metric     MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  enrollment Enrollment?      @relation(fields: [enrollmentId], references: [id])

  @@index([metricId, observedAt])
  @@index([enrollmentId, observedAt])
  @@map("metric_observations")
}

model AlertRule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  metricId       String   @map("metric_id")
  name           String
  operator       String   // "lt", "gt", "eq", "delta_lt", "delta_gt"
  threshold      Float
  severity       String   // "low", "medium", "high", "critical"
  cooldownHours  Int      @default(24) @map("cooldown_hours")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@index([organizationId, active])
  @@index([metricId])
  @@map("alert_rules")
}

model Alert {
  id           String    @id @default(uuid())
  ruleId       String    @map("rule_id")
  enrollmentId String    @map("enrollment_id")
  severity     String    // copied from rule at trigger time
  triggerValue Float     @map("trigger_value")
  message      String?
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  rule       AlertRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  enrollment Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reviews    AlertReview[]

  @@index([ruleId, createdAt])
  @@index([enrollmentId, resolvedAt])
  @@map("alerts")
}

model AlertReview {
  id         String   @id @default(uuid())
  alertId    String   @map("alert_id")
  reviewerId String   @map("reviewer_id")
  action     String   // "acknowledged", "escalated", "resolved", "dismissed"
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  alert    Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  reviewer MentorProfile @relation(fields: [reviewerId], references: [id])

  @@index([alertId])
  @@index([reviewerId])
  @@map("alert_reviews")
}

enum AssessmentSessionStatus {
  pending
  in_progress
  completed
}

model AssessmentSession {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  socioId        String                  @map("socio_id")
  lessonKey      String                  @map("lesson_key")
  blockId        String?                 @map("block_id")
  kind           String                  @default("teach_back")
  status         AssessmentSessionStatus @default(pending)
  attemptNumber  Int                     @default(1) @map("attempt_number")
  turnCount      Int                     @default(0) @map("turn_count")
  liveState      Json?                   @map("live_state")
  scores         Json?
  passedAt       DateTime?               @map("passed_at")
  completedAt    DateTime?               @map("completed_at")
  configSnapshot Json?                   @map("config_snapshot")
  channel        String                  @default("web")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  socio    Socio     @relation(fields: [socioId], references: [id])
  messages Message[]

  @@unique([socioId, lessonKey, attemptNumber])
  @@index([organizationId])
  @@index([socioId, status])
  @@map("assessment_sessions")
}

model AiInvocation {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now()) @map("created_at")
  organizationId      String?  @map("organization_id")
  socioId             String?  @map("socio_id")
  assessmentSessionId String?  @map("assessment_session_id")
  // Free-form string, not an enum: a new operation must not require a migration.
  // lesson_delivery | assessment_turn | sensing | assessment_sensing | sentiment
  // | summary | onboarding
  operation           String
  mode                String?
  model               String
  promptTokensApprox  Int?     @map("prompt_tokens_approx")
  responseLength      Int?     @map("response_length")
  latencyMs           Int      @map("latency_ms")
  // { core, context, task, content, language, evaluator } - whatever subset applies
  promptVersion       Json     @map("prompt_version")
  promptHash          String   @map("prompt_hash")
  // Full assembled prompt, stored ONLY when AI_TRACE=full
  promptText          String?  @map("prompt_text")
  success             Boolean
  errorMessage        String?  @map("error_message")

  @@index([operation, createdAt])
  @@index([socioId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_invocations")
}
